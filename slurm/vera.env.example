# Copy to slurm/vera.env (not committed) and fill in. Sourced by the job
# scripts, which must be submitted from the repository root.

# Python: pick a module with `module spider Python`, then create the venv once:
#   module load <that module>; python -m venv ~/venvs/nt
#   source ~/venvs/nt/bin/activate; pip install -r requirements.txt
module purge
module load Python/3.12.3-GCCcore-13.3.0     # replace with what `module spider Python` lists
source "$HOME/venvs/nt/bin/activate"

# Patched Twee: either the static binary copied from your laptop ...
export TWEE_PATH="$HOME/bin/twee"
# ... or the Apptainer fallback (see slurm/README.md):
# export TWEE_SIF="$HOME/containers/twee.sif"
# export TWEE_PATH="$PWD/slurm/twee-apptainer"

# Directory containing TPTP's Axioms/ (only Axioms/ is needed).
export TPTP_ROOT="$HOME/TPTP-v9.2.1"
# Clone of WeAreDevo/ijcar26-twee_abstractions (for the problem files).
export TWITCH_DIR="$HOME/ijcar26-twee_abstractions"
