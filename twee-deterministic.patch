+newTask = newTaskWithClock (liftIO getCPUTime)
+
+-- | Like 'newTask', but measure time with the given clock (in picoseconds)
+-- instead of CPU time. With a clock that only depends on the prover's own
+-- progress, the task schedule is deterministic.
+newTaskWithClock :: MonadIO m => m Integer -> Double -> Double -> m a -> m (Task m a)
+newTaskWithClock clock freq budget what = do
+  now <- clock
+  liftIO $ Task <$> newIORef (TaskData now now 0 freq budget what clock)
+
+-- | A clock that measures the bytes allocated by the current Haskell thread,
+-- counting the given number of bytes as one second. Allocation depends only
+-- on the work the prover does, so a task schedule driven by it is
+-- reproducible, and unlike a count of critical pairs it also advances while
+-- a task runs, so task budgets still apply.
+allocationClock :: MonadIO m => Int64 -> m Integer
+allocationClock bytesPerSecond = liftIO $ do
+  -- The allocation counter counts down from zero as the thread allocates.
+  counter <- getAllocationCounter
+  return (negate (toInteger counter) * 10^(12::Int) `div` toInteger bytesPerSecond)
 
